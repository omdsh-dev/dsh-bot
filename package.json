{
  "name": "dsh-bot",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Persistent AI teammates and multi-Bot chats, as a native DeepSeek Harness plugin.",
  "license": "MIT",
  "repository": "github:zzzpyyy/dsh-bot",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prepare:runtime": "node scripts/setup.mjs --prepare-only",
    "start": "node scripts/start.mjs",
    "test": "node --test scripts/start.test.mjs && node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "pack": "node scripts/pack.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "test:install": "node --test scripts/install.test.mjs",
    "test:registry": "node --test scripts/registry.test.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "pack:infoflow": "node scripts/pack-infoflow.mjs",
    "test:infoflow-package": "node --test scripts/infoflow-package.test.mjs",
    "test:infoflow-managed-package": "node --test scripts/infoflow-managed-package.test.mjs",
    "pack:feishu": "node scripts/pack-feishu.mjs",
    "test:feishu-package": "node --test scripts/feishu-package.test.mjs",
    "test:im-isolation-package": "node --test scripts/im-isolation-package.test.mjs",
    "test:im-delegation-package": "node --test scripts/im-delegation-package.test.mjs",
    "test:compatibility": "node scripts/test-compatibility.mjs",
    "test:client-package": "node scripts/test-client-package.mjs"
  }
}
